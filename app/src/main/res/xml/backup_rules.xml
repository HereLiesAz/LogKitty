<?xml version="1.0" encoding="utf-8"?>
<!-- Android 11 and below. Saved session logs (files/) are deliberately excluded: logcat output can
     contain other apps' private data. Matches data_extraction_rules.xml. -->
<full-backup-content>
    <include domain="sharedpref" path="."/>
    <include domain="database" path="."/>
    <!-- Legacy GitHub token store (purged on launch); never let an old copy leave the device. -->
    <exclude domain="sharedpref" path="logkitty_secure_prefs.xml"/>
</full-backup-content>
