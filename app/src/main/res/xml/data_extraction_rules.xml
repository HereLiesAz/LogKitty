<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+. Saved session logs (files/) are never backed up or transferred: logcat output can
     contain other apps' private data. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="."/>
        <include domain="sharedpref" path="."/>
        <!-- Legacy GitHub token store (purged on launch); never let an old copy leave the device. -->
        <exclude domain="sharedpref" path="logkitty_secure_prefs.xml"/>
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="."/>
        <include domain="sharedpref" path="."/>
        <!-- Legacy GitHub token store (purged on launch); never let an old copy leave the device. -->
        <exclude domain="sharedpref" path="logkitty_secure_prefs.xml"/>
    </device-transfer>
</data-extraction-rules>
